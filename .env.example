# Optional: GitHub requests work without a token, with a lower API quota.
# Supply your own token here; never commit the resulting .env file.
GITHUB_TOKEN=

# Optional manual on-chain checks. Uncomment only the chains you want to check.
# Discovery does not use RPC. Requests happen only after clicking Check on-chain.
# ETH_RPC_URL=
# ARBITRUM_RPC_URL=
# OPTIMISM_RPC_URL=
# BASE_RPC_URL=
# POLYGON_RPC_URL=
# BSC_RPC_URL=
# AVALANCHE_RPC_URL=
# GNOSIS_RPC_URL=
